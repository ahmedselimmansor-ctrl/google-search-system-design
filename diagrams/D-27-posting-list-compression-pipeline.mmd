    classDef codec fill:#fde68a,stroke:#b45309,color:#1c1917
    classDef win fill:#bbf7d0,stroke:#15803d,color:#1c1917
    class SORT,DELTA,SKIP,BLOCK step
    class VB,GOL,PFOR codec
    class OUT win
